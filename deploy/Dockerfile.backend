FROM python:3.12-slim AS runtime

WORKDIR /app
COPY deploy/requirements.txt /tmp/requirements.txt
COPY deploy/requirements.teachkg.txt /tmp/requirements.teachkg.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt -r /tmp/requirements.teachkg.txt
COPY service /app/service
COPY teachkg /app/teachkg
COPY prompts /app/prompts
COPY configs /app/configs
COPY scripts /app/scripts
# Needed by scripts.teaching.export_pipeline_showcase (HTML wrapper)
COPY web/pipeline-showcase /app/web/pipeline-showcase
ENV PYTHONPATH=/app
ENV MMKG_REPO_ROOT=/app
WORKDIR /app/service
CMD ["uvicorn", "mmkg_api.main:app", "--host", "0.0.0.0", "--port", "8000"]

FROM python:3.12-slim AS debug
WORKDIR /app
COPY deploy/requirements.txt /tmp/requirements.txt
COPY deploy/requirements.debug.txt /tmp/requirements.debug.txt
COPY deploy/requirements.teachkg.txt /tmp/requirements.teachkg.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt -r /tmp/requirements.debug.txt -r /tmp/requirements.teachkg.txt
COPY service /app/service
COPY teachkg /app/teachkg
COPY prompts /app/prompts
COPY configs /app/configs
COPY scripts /app/scripts
COPY web/pipeline-showcase /app/web/pipeline-showcase
ENV PYTHONPATH=/app
ENV MMKG_REPO_ROOT=/app
WORKDIR /app/service
CMD ["uvicorn", "mmkg_api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
