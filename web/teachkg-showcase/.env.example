# 可选：配置后优先走商业搜索，质量更好。未配置时仍用公开源联网检索。
# 复制为 .env.local 后重启 npm run dev

BRAVE_API_KEY=
BING_SEARCH_KEY=
SERPAPI_KEY=
YOUTUBE_API_KEY=

# 图谱问答大模型（OpenAI 兼容：/v1/chat/completions）
# 课堂材料优先；不足时才允许课外知识（回答中会标注）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=deepseek-v4-flash-0731
# 也兼容 OPENAI_* / DASHSCOPE_API_KEY / DASHSCOPE_BASE_URL
