LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=deepseek-v4-flash-0731
# 也兼容 OPENAI_* / DASHSCOPE_API_KEY / DASHSCOPE_BASE_URL

# AI-Teaching：习题/动画/公式关联（iframe 带 kg_token，不暴露内部凭证）
