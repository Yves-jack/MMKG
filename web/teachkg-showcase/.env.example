# 可选：配置后优先走商业搜索，质量更好。未配置时仍用公开源联网检索。
# 复制为 .env.local 后重启 npm run dev

BRAVE_API_KEY=
BING_SEARCH_KEY=
SERPAPI_KEY=
YOUTUBE_API_KEY=

# 图谱问答 / 导图整理 / 复习笔记等（OpenAI 兼容 chat/completions）
# 默认走交大 SJTU；也可只配 LLM_*（指向 SJTU）
SJTU_LLM_API_KEY=
# 或：LLM_API_KEY=
LLM_BASE_URL=https://models.sjtu.edu.cn/api
LLM_MODEL=deepseek-chat
# 可选回退：DASHSCOPE_API_KEY / DASHSCOPE_BASE_URL（不推荐作问答默认）
